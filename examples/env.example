# ---------------------------------------------------------------------------
# Feeds. Both optional, both free, both worth getting.
# ---------------------------------------------------------------------------
NVD_API_KEY=          # nvd.nist.gov/developers/request-an-api-key, 5 to 50 req/30s
GITHUB_TOKEN=         # any PAT, no scopes needed

# ---------------------------------------------------------------------------
# Your estate
# ---------------------------------------------------------------------------
VULNOMETRY_INVENTORY=./vulnometry.yaml

# ---------------------------------------------------------------------------
# Inference. None of this is needed for measure, import, sweep or compare.
# ---------------------------------------------------------------------------
VULNOMETRY_MODEL=ollama:qwen3

OLLAMA_HOST=http://localhost:11434

# Any OpenAI-compatible server: vLLM, llama.cpp, LM Studio, TGI, Jan
VULNOMETRY_ONPREM_BASE_URL=http://localhost:8000/v1
VULNOMETRY_ONPREM_API_KEY=not-needed

# OpenAI, Codex, or any compatible gateway (OpenRouter, Groq, Together)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure AI Foundry / Azure OpenAI. Both endpoint shapes are auto-detected:
#   https://<resource>.openai.azure.com        model = deployment name
#   https://<resource>.services.ai.azure.com   model = model name
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# AWS Bedrock. Credentials come from boto3's normal chain.
AWS_REGION=us-east-1
# AWS_PROFILE=my-profile

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# VULNOMETRY_STATE_DIR=~/.local/state/vulnometry
# VULNOMETRY_OFFLINE=0        # serve only from cache, never touch the network
# VULNOMETRY_NO_CACHE=0
# VULNOMETRY_TIMEOUT=25
# VULNOMETRY_MAX_TURNS=8
